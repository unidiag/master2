Options -Indexes

DirectoryIndex index.php

<FilesMatch "^(config\.local\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^app/ - [F,L]

    RewriteRule ^stroka/infocanal\.txt$ index.php [L,QSA]
    RewriteRule ^stroka/new\.json$ index.php [L,QSA]
</IfModule>